<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://showmaniac.com/tv" version="1.0.0" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:application id="ShowManiac.tv" package="ShowManiac" required_version="3.0"/>
    <content src="index.html"></content>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"></icon>
    <name>showmaniac</name>
    <description>Track your TV shows and play the next episode on your TV.</description>
    <author href="https://showmaniac.com">showmaniac</author>
    <tizen:profile name="tv-samsung"/>
    <!-- network access for TVmaze, TMDB, Trakt and Firebase -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <!-- opens play links in the TV browser -->
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <!-- play/pause key on the remote -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <!-- only used as a fallback when the TV browser cannot be launched -->
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
